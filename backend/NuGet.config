<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Scope restore to nuget.org only, so builds do not depend on feeds that
       happen to be configured on an individual developer's machine. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
